      <geom type="mesh" class="collision" mesh="wrist_camera_mount_so101_v1" material="wrist_camera_mount_so101_v1_material"/>
      <!-- Link wrist_camera: lens points along +z -->
      <body name="wrist_camera" pos="-0.04941 -0.03813 0.0175" quat="0.37978693649389456 -0.5964584309361936 -0.37978833153177 -0.596456240026065">
        <inertial pos="0 0 0" mass="0.015" diaginertia="1e-5 1e-5 1e-5"/>
        <geom type="mesh" class="visual" mesh="wrist_camera_so101_v1" material="wrist_camera_so101_v1_material"/>
        <geom type="mesh" class="collision" mesh="wrist_camera_so101_v1" material="wrist_camera_so101_v1_material"/>
        <camera name="wrist_camera" pos="0 0 0.0263" quat="0 1 0 0" fovy="100" resolution="640 480"/>
      </body>
    </body>
  </worldbody>
</mujoco>
