<!--
  Wrist camera mount + innomaker 32x32 UVC module, placed as in urdf/so101_wrist_camera.xacro
-->
<mujoco>
  <asset>
    <mesh file="wrist_camera_mount_so101_v1.stl" scale="0.001 0.001 0.001"/>
    <mesh file="wrist_camera_so101_v1.stl"/>
    <material name="wrist_camera_mount_so101_v1_material" rgba="0.95 0.95 0.95 1"/>
    <material name="wrist_camera_so101_v1_material" rgba="0.1 0.1 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Link wrist_camera_mount (Hex-Nut Recess, 32x32 UVC module form factor) -->
    <body name="wrist_camera_mount" pos="-0.0150 0.0240 -0.0315" quat="0.4997981226682881 -0.5001999599912927 0.4998017973423795 -0.5001999599912927">
      <inertial pos="0 0 0" mass="0.02" diaginertia="1e-5 1e-5 1e-5"/>
