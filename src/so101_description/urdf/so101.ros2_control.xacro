<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so101_joint" params="name initial_position:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="so101_ros2_control"
               params="name sim:=mock headless:=false wrist_camera:=false">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${sim == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim == 'mujoco'}">
          <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
          <param name="mujoco_model">$(find so101_description)/mjcf/${'scene_camera' if wrist_camera else 'scene'}.xml</param>
          <param name="headless">${'true' if headless else 'false'}</param>
        </xacro:if>
        <xacro:unless value="${sim in ('mock', 'mujoco')}">
          ${xacro.fatal("sim must be 'mock' or 'mujoco', got '" + sim + "'")}
        </xacro:unless>
      </hardware>
      <xacro:so101_joint name="shoulder_pan"/>
      <xacro:so101_joint name="shoulder_lift"/>
      <xacro:so101_joint name="elbow_flex"/>
      <xacro:so101_joint name="wrist_flex"/>
      <xacro:so101_joint name="wrist_roll"/>
      <xacro:so101_joint name="gripper"/>
    </ros2_control>
  </xacro:macro>

</robot>
