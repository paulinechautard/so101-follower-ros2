<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so101_joint" params="name hardware read_only:=false calib:=None servo_p:=16">
    <joint name="${name}">
      <xacro:if value="${hardware == 'real'}">
        <param name="motor_id">${calib['id']}</param>
        <param name="operating_mode">0</param>
        <!-- LeRobot and the URDF: rising raw step = positive angle -->
        <param name="invert_direction">true</param>
        <xacro:property name="center" value="${calib['range_min'] if name == 'gripper' else int(round((calib['range_min'] + calib['range_max']) / 2.0))}"/>
        <param name="position_center_steps">${center}</param>
        <xacro:unless value="${read_only}">
          <!-- Calibrated range: a backstop, the controllers enforce the URDF limits -->
          <param name="min_position">${(calib['range_min'] - center) * pi / 2048}</param>
          <param name="max_position">${(calib['range_max'] - center) * pi / 2048}</param>
          <!-- LeRobot's settings (so_follower.py configure()) -->
          <param name="p_coefficient">${servo_p}</param>
          <param name="i_coefficient">0</param>
          <param name="d_coefficient">32</param>
          <xacro:if value="${name == 'gripper'}">
            <param name="protection_current">250</param>
            <param name="overload_torque">25</param>
          </xacro:if>
        </xacro:unless>
      </xacro:if>
      <xacro:unless value="${read_only}">
        <command_interface name="position"/>
      </xacro:unless>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="so101_ros2_control"
               params="name hardware:=mock headless:=false mujoco_model:='' wrist_camera:=false
                       calibration:='' serial_port:=/dev/ttyACM0 read_only:=true dry_run:=false servo_p:=16">
    <xacro:if value="${hardware == 'real'}">
      <xacro:if value="${calibration == ''}">
        ${xacro.fatal("hardware 'real' needs a calibration file (LeRobot JSON)")}
      </xacro:if>
      <xacro:property name="calib" value="${xacro.load_yaml(calibration)}"/>
    </xacro:if>
    <xacro:unless value="${hardware == 'real'}">
      <xacro:property name="calib" value="${dict()}"/>
      <xacro:property name="read_only" value="false"/>
    </xacro:unless>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${hardware == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${hardware == 'mujoco'}">
          <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
          <xacro:if value="${mujoco_model == ''}">
            <param name="mujoco_model">$(find so101_description)/mjcf/scene${'_camera' if wrist_camera else ''}.xml</param>
          </xacro:if>
          <xacro:unless value="${mujoco_model == ''}">
            <param name="mujoco_model">${mujoco_model}</param>
          </xacro:unless>
          <param name="headless">${'true' if headless else 'false'}</param>
        </xacro:if>
        <xacro:if value="${hardware == 'real'}">
          <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="baud_rate">1000000</param>
          <param name="enable_mock_mode">${'true' if dry_run else 'false'}</param>
          <param name="hold_position_on_activate">true</param>
          <param name="reset_states_on_activate">false</param>
        </xacro:if>
        <xacro:unless value="${hardware in ('mock', 'mujoco', 'real')}">
          ${xacro.fatal("hardware must be 'mock', 'mujoco' or 'real', got '" + hardware + "'")}
        </xacro:unless>
      </hardware>
      <xacro:so101_joint name="shoulder_pan" hardware="${hardware}" read_only="${read_only}" calib="${calib.get('shoulder_pan')}" servo_p="${servo_p}"/>
      <xacro:so101_joint name="shoulder_lift" hardware="${hardware}" read_only="${read_only}" calib="${calib.get('shoulder_lift')}" servo_p="${servo_p}"/>
      <xacro:so101_joint name="elbow_flex" hardware="${hardware}" read_only="${read_only}" calib="${calib.get('elbow_flex')}" servo_p="${servo_p}"/>
      <xacro:so101_joint name="wrist_flex" hardware="${hardware}" read_only="${read_only}" calib="${calib.get('wrist_flex')}" servo_p="${servo_p}"/>
      <xacro:so101_joint name="wrist_roll" hardware="${hardware}" read_only="${read_only}" calib="${calib.get('wrist_roll')}" servo_p="${servo_p}"/>
      <xacro:so101_joint name="gripper" hardware="${hardware}" read_only="${read_only}" calib="${calib.get('gripper')}" servo_p="${servo_p}"/>
    </ros2_control>
  </xacro:macro>

</robot>
